{
  "compilerOptions": {
    "target": "ES2021",
    "module": "None",
    "moduleResolution": "Node",
    "isolatedModules": false,
    "declaration": true,
    "noImplicitAny": false,
    "removeComments": true,
    "allowUnreachableCode": false
  },
  "compileOnSave": true,
  "buildOnSave": true
}
